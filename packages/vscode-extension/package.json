{
    "name": "blueprintor",
    "displayName": "Blueprintor",
    "description": "Create files and folders from your own templates with one command.",
    "version": "0.0.2",
    "publisher": "ShurpoT",
    "license": "MIT",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/ShurpoT/blueprintor.git",
        "directory": "packages/vscode-extension"
    },
    "bugs": {
        "url": "https://github.com/ShurpoT/blueprintor/issues"
    },
    "homepage": "https://shurpot.github.io/blueprintor/",
    "keywords": [
        "scaffold",
        "blueprintor",
        "template",
        "boilerplate",
        "generator",
        "blueprint",
        "file",
        "folder"
    ],
    "engines": {
        "vscode": "^1.103.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "File Blueprintor runs blueprintor.config.js from the workspace, which is executable code."
        }
    },
    "contributes": {
        "commands": [
            {
                "command": "blueprintor.run",
                "title": "Run Blueprintor...",
                "icon": "$(package)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "blueprintor.run",
                    "when": "view == workbench.explorer.fileView",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "command": "blueprintor.run",
                    "when": "explorerResourceIsFolder",
                    "group": "2_workspace"
                }
            ]
        },
        "configuration": {
            "title": "File Blueprintor",
            "properties": {
                "blueprintor.defaultConfig": {
                    "type": "object",
                    "default": {
                        "blueprints": []
                    },
                    "markdownDescription": "Global blueprints. They are merged with `blueprintor.config.js`; on the same `title` the local blueprint wins.",
                    "properties": {
                        "blueprints": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "title",
                                    "structure"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "pattern": "^\\s*[^\\u0000-\\u001F\\u007F\\s](?:[^\\u0000-\\u001F\\u007F]*[^\\u0000-\\u001F\\u007F\\s])?\\s*$",
                                        "patternErrorMessage": "The title must not be blank or contain control characters.",
                                        "markdownDescription": "Name in the blueprint list. Also the key used to merge global and local blueprints."
                                    },
                                    "variables": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "required": [
                                                "key"
                                            ],
                                            "properties": {
                                                "key": {
                                                    "type": "string",
                                                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                                                    "patternErrorMessage": "Use letters, digits and underscores; must not start with a digit."
                                                },
                                                "prompt": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "snippets": {
                                        "type": "object",
                                        "markdownDescription": "Named texts that files can reference with `snippet`. Names follow the same rule as variable keys.",
                                        "propertyNames": {
                                            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                                            "patternErrorMessage": "Use letters, digits and underscores; must not start with a digit."
                                        },
                                        "additionalProperties": {
                                            "anyOf": [
                                                {
                                                    "type": "string"
                                                },
                                                {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    "structure": {
                                        "type": "object",
                                        "properties": {
                                            "files": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "required": [
                                                        "name"
                                                    ],
                                                    "properties": {
                                                        "name": {
                                                            "type": "string",
                                                            "pattern": "^[^<>:\"|?*\\u0000-\\u001F/\\\\]+$",
                                                            "patternErrorMessage": "Names must not contain / \\ < > : \" | ? * or control characters. Use \"folders\" for nesting."
                                                        },
                                                        "snippet": {
                                                            "type": "string"
                                                        },
                                                        "content": {
                                                            "anyOf": [
                                                                {
                                                                    "type": "string"
                                                                },
                                                                {
                                                                    "type": "array",
                                                                    "items": {
                                                                        "type": "string"
                                                                    }
                                                                }
                                                            ]
                                                        }
                                                    }
                                                }
                                            },
                                            "folders": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "required": [
                                                        "name"
                                                    ],
                                                    "properties": {
                                                        "name": {
                                                            "type": "string",
                                                            "pattern": "^[^<>:\"|?*\\u0000-\\u001F/\\\\]+$",
                                                            "patternErrorMessage": "Names must not contain / \\ < > : \" | ? * or control characters. Use \"folders\" for nesting."
                                                        },
                                                        "files": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "object",
                                                                "required": [
                                                                    "name"
                                                                ],
                                                                "properties": {
                                                                    "name": {
                                                                        "type": "string",
                                                                        "pattern": "^[^<>:\"|?*\\u0000-\\u001F/\\\\]+$",
                                                                        "patternErrorMessage": "Names must not contain / \\ < > : \" | ? * or control characters. Use \"folders\" for nesting."
                                                                    },
                                                                    "snippet": {
                                                                        "type": "string"
                                                                    },
                                                                    "content": {
                                                                        "anyOf": [
                                                                            {
                                                                                "type": "string"
                                                                            },
                                                                            {
                                                                                "type": "array",
                                                                                "items": {
                                                                                    "type": "string"
                                                                                }
                                                                            }
                                                                        ]
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        "folders": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "object"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package --no-dependencies"
    },
    "devDependencies": {
        "@types/node": "24.x",
        "@types/vscode": "^1.103.0",
        "typescript": "^6.0.3"
    }
}
